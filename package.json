{
  "name": "clirip",
  "version": "0.1.0",
  "description": "Multi-engine media downloader for the terminal",
  "type": "module",
  "bin": {
    "clirip": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "tsup": {
    "entry": [
      "src/cli.tsx"
    ],
    "format": [
      "esm"
    ],
    "banner": {
      "js": "#!/usr/bin/env node"
    },
    "sourcemap": false,
    "clean": true,
    "target": "node18"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ink": "5.2.1",
    "ink-select-input": "6.2.0",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "ink-testing-library": "4.0.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
